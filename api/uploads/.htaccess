# Uploaded files are user-supplied - never execute anything from this directory as a script,
# no matter what extension or MIME-spoofing tricks got past UploadService's validation.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
