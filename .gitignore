# New eSpace-style stack (shared/, backend/, public-site/, admin-frontend/)
shared/storage/cache
shared/storage/logs
shared/vendor
backend/vendor
public-site/vendor
admin-frontend/node_modules
admin-frontend/dist
public-site/node_modules
public-frontend/node_modules
public-frontend/dist
storage/uploads/*
!storage/uploads/.gitkeep

# uploads is physically storage/uploads/ - also reachable (same files) via these junctions
uploads/*
api/uploads/*
backend/public/uploads/*
public-site/public/uploads/*

# assets is physically public-site/public/assets/ - same duplication issue as uploads above
assets/*
