# Deny direct access to everything in backend/ except public/ (which has its own .htaccess
# allowing it) - app/, routes/, vendor/, composer.json etc. must never be served directly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
