# Production .env for hosting this project at the ROOT of a cPanel account. Copy to shared/.env
# on the server and fill in the real values cPanel's "MySQL Databases" and "Email Accounts" pages
# give you - see deploy/README.md for the full walkthrough this file is one step of.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpanelusername_stmarkswebsite
DB_USER=cpanelusername_dbuser
DB_PASS=REPLACE_WITH_REAL_DB_PASSWORD

APP_ENV=production
APP_DEBUG=false
APP_NAME="St Mark's College Namagoma"

# Same-origin deploy (admin SPA and API both served from the same domain via the root .htaccess) -
# ADMIN_FRONTEND_URL only matters for CORS, which same-origin doesn't need, but keep it accurate.
ADMIN_FRONTEND_URL=https://yourdomain.com/admin
# Root deploy - the site's public-facing base path is empty, unlike local dev's /stmarkswebsite.
PUBLIC_SITE_BASE_PATH=

SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

MAX_UPLOAD_SIZE=52428800

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_REAL_MAIL_USERNAME
MAIL_PASSWORD=REPLACE_WITH_REAL_MAIL_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=REPLACE_WITH_REAL_FROM_ADDRESS
MAIL_FROM_NAME="St Mark's College Namagoma"
CONTACT_RECIPIENTS=info@stmark.sc.ug
