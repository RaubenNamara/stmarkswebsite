# shared/ has no public/ subfolder - it's a pure PHP library (Config, Models, Services), never
# meant to be reached over HTTP directly. Denied here too, not just at the project root, in case
# something ever serves this directory from a different docroot.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
