DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stmarkswebsite
DB_USER=root
DB_PASS=

APP_ENV=local
APP_DEBUG=true
APP_NAME="St. Mark's College Namagoma"

# Origin the admin SPA is served from (used for CORS if ever deployed cross-origin; same-origin deploys don't need it).
ADMIN_FRONTEND_URL=http://localhost/stmarkswebsite/admin
# Set only when public-site is reached through a project-root rewrite instead of being the
# vhost's actual DocumentRoot (e.g. local dev under a subfolder). Leave empty in production.
PUBLIC_SITE_BASE_PATH=

SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

STORAGE_PATH=
UPLOADS_PATH=
MAX_UPLOAD_SIZE=52428800

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="St. Mark's College Namagoma"
CONTACT_RECIPIENTS=info@stmark.sc.ug

# Homepage "Latest Updates from SMACON" X feed (see shared/src/Services/XFeedService.php).
# Option A - automatic latest posts: an X API bearer token (prepaid pay-per-use, billed per post
# read). Server-side only; never put it in public-frontend's .env.
X_API_BEARER_TOKEN=
# Option B - no API account: up to 4 post URLs from x.com/Smacon24, newest first, comma separated.
# Fetched through X's free public oEmbed endpoint (text/date/link only, no media files).
X_FEED_POST_URLS=
# How long a fetched feed is reused before asking X again.
X_FEED_CACHE_MINUTES=60
