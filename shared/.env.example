DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stmarkswebsite
DB_USER=root
DB_PASS=

APP_ENV=local
APP_DEBUG=true
APP_NAME="St Mark's College Namagoma"

# Origin the admin SPA is served from (used for CORS if ever deployed cross-origin; same-origin deploys don't need it).
ADMIN_FRONTEND_URL=http://localhost/stmarkswebsite/admin
# Set only when public-site is reached through a project-root rewrite instead of being the
# vhost's actual DocumentRoot (e.g. local dev under a subfolder). Leave empty in production.
PUBLIC_SITE_BASE_PATH=

SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token

STORAGE_PATH=
UPLOADS_PATH=
MAX_UPLOAD_SIZE=52428800

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="St Mark's College Namagoma"
CONTACT_RECIPIENTS=info@stmark.sc.ug
